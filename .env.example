# ANT OS Environment Configuration

# Logging level
RUST_LOG=info,ant=debug

# NATS URL for distributed mode (optional)
# NATS_URL=nats://localhost:4222

# Redis URL for distributed state store (optional)
# REDIS_URL=redis://localhost:6379

# OpenRouter API key for LLM integration
OPENROUTER_API_KEY=your_api_key_here

# WASM sandbox limits
WASM_FUEL_LIMIT=10000000
WASM_MEMORY_LIMIT=67108864
WASM_TIME_LIMIT_MS=30000

# Metrics server port
METRICS_PORT=9090

# DuckDB audit log path
DUCKDB_PATH=./ant_audit.duckdb

# Pod name (for K8s)
POD_NAME=ant-local
